# Copy to .env and fill in. .env is git-ignored; never commit it.
# Every variable, its default and what it guards against: docs/CONFIG.md.
#
# A network is enabled when all six of its variables are set; setting only some is an error.
# Supported prefixes: MAINNET, SIGNET, TESTNET4, REGTEST.

# Server. LISTEN_ADDR is also where `bun run dev` proxies /api, /app and /healthz.
LISTEN_ADDR=127.0.0.1:8080
# The built frontend (web/dist after `bun run build`).
WEB_DIR=web/dist
# One SQLite file per network for derived and observed data (docs/STORE.md). Unset: no store.
DATA_DIR=data
# The block table's backfill (docs/CONFIG.md). false pauses it; it resumes on the next start.
# BACKFILL_ENABLED=true
# Share of time, 1 to 100, it keeps the node busy.
# BACKFILL_BUSY_PERCENT=50
# Blocks below the tip that get fee rates; about a year.
# BACKFILL_FEE_RATE_DEPTH=52560

# JSON-RPC (rbitcoin --rpc-listen). HTTP Basic auth.
MAINNET_RPC_HOST=127.0.0.1
MAINNET_RPC_PORT=8332
MAINNET_RPC_USER=
MAINNET_RPC_PASSWORD=

# Esplora REST (rbitcoin --esplora-listen). A URL, or a unix socket path.
MAINNET_ESPLORA_URL=http://127.0.0.1:3000

# Electrum (rbitcoin --electrum-listen). Plain TCP host:port.
MAINNET_ELECTRUM_ADDR=127.0.0.1:50001

# The live mempool: the tracker polls the node about once a second (about 150 MB a minute on
# mainnet) and the projected blocks ask it for clusters. On by default. If you develop against a
# shared node, turn it off unless you are working on the mempool (docs/CONFIG.md).
# MAINNET_MEMPOOL_ENABLED=true

# Other networks take the same six variables under their own prefix, for example:
# SIGNET_RPC_HOST=127.0.0.1
# SIGNET_RPC_PORT=38332
# SIGNET_RPC_USER=
# SIGNET_RPC_PASSWORD=
# SIGNET_ESPLORA_URL=http://127.0.0.1:3002
# SIGNET_ELECTRUM_ADDR=127.0.0.1:60601

# POST /api/tx, the only write to the node. Set to false to turn it off.
# BROADCAST_ENABLED=true

# Logging (docs/LOGGING.md). Format defaults to json, or text when stdout is a terminal.
# LOG_FORMAT=json
# LOG_LEVEL=info
# Which requests are logged: all, failures or off.
# LOG_REQUESTS=all
# Adds the client address to request events. Off for privacy; see docs/LOGGING.md.
# LOG_CLIENT_ADDR=false

# Limits. The defaults are shown; uncomment to change.
# MAX_BODY_BYTES=16384
# REQUEST_TIMEOUT_SECS=10
# MAX_CONNECTIONS=1024
# MAX_CONCURRENT_REQUESTS=256
# CLIENT_MAX_CONNECTIONS=64
# CLIENT_MAX_CONCURRENT_REQUESTS=48
# CLIENT_RATE_PER_SEC=20
# CLIENT_BURST=120
# MAX_TRACKED_CLIENTS=65536
# Memory for cached block summaries, per network (docs/CONFIG.md).
# BLOCK_SUMMARY_CACHE_MB=32
# WebSocket limits (docs/WS.md).
# WS_MAX_SOCKETS=1024
# WS_CLIENT_MAX_SOCKETS=16
# WS_MAX_MESSAGE_BYTES=1024
# WS_MESSAGES_PER_SEC=10
# WS_MAX_SUBSCRIPTIONS=8
# WS_SEND_QUEUE=64
# WS_IDLE_TIMEOUT_SECS=60
# The mempool topics (docs/WS.md).
# WS_MAX_BLOCK_SUBSCRIPTIONS=2
# WS_MEMPOOL_INTERVAL_MS=2000
# WS_LATEST_TXS=10
# Following transactions and addresses (docs/WS.md).
# WS_MAX_TRACKED_TXS=4
# WS_MAX_TRACKED_ADDRESSES=2
# WS_TRACKED_TXS_TOTAL=10000
# WS_TRACKED_ADDRESSES_TOTAL=1000
# WS_POSITION_INTERVAL_MS=10000
# Replacements remembered per network, in memory (docs/MEMPOOL.md).
# REPLACEMENTS_KEPT=10000
# Only behind a reverse proxy that overwrites it: the header, and the proxies allowed to send it
# (addresses or CIDR prefixes). Both or neither (docs/CONFIG.md).
# TRUSTED_PROXY_HEADER=X-Real-IP
# TRUSTED_PROXIES=127.0.0.1
