# Copy to deploy/.env and fill in. .env is git-ignored; never commit it.
# docs/DEPLOY.md explains each line; docs/CONFIG.md lists every server variable.

# The node: one of mainnet, signet, testnet4, regtest, and its P2P port
# (mainnet 8333, signet 38333, testnet4 48333, regtest 18444).
NETWORK=mainnet
P2P_PORT=8333
# Where the P2P port is published on the host, [ip:]port. Defaults to P2P_PORT.
# P2P_PUBLISH=8333

# The server: the same network's six variables, pointing at the node service.
# The node reads the same user and password from rpc.cookie (docs/DEPLOY.md).
MAINNET_RPC_HOST=node
MAINNET_RPC_PORT=8332
MAINNET_RPC_USER=mempool-based
MAINNET_RPC_PASSWORD=
MAINNET_ESPLORA_URL=/run/esplora/esplora.sock
MAINNET_ELECTRUM_ADDR=node:50001

# Where the server's HTTP port is published on the host, [ip:]port. Keep it on loopback
# behind a reverse proxy that terminates TLS, and tell the server which header that proxy sets.
# HTTP_PUBLISH=127.0.0.1:8080
TRUSTED_PROXY_HEADER=X-Real-IP

# Everything else in docs/CONFIG.md goes here too: limits, and BROADCAST_ENABLED=false
# to turn off POST /api/tx, the only write the server makes to the node.
